{
    id: "SCORECARD-DANGEROURS-WF"
    meta: {
        name: "No Dangerous Workflows"
        description: "Reads the project's attested [OpenSSF Scorecard](https://scorecard.dev) results. Fails when Scorecard detected workflows with dangerous patterns, such as untrusted input reaching privileged steps."
    }
    tenets: [
        {
            id: "01-scorecard"
            code: "size(outputs.bin_artifacts_checks) > 0 && outputs.bin_artifacts_checks.all(c, c.score == 10)"
            outputs: {
                bin_artifacts_checks: {
                    code: "has(predicates[0].data.checks) ? predicates[0].data.checks.filter(c, c.name == 'Dangerous-Workflow' && has(c.score)) : [] "
                }
            }
            predicates: {
                types: [
                    "https://scorecard.dev/result/v0.1"
                ]
            }
            assessment: {
                message: "Scorecard found no dangerous pipelines"
            }
            error: {
                message: "Scorecard detected workflows with dangerous patterns"
                guidance: "Review your workflow files and look for dangerous patterns"
            }
        }
    ]
}
