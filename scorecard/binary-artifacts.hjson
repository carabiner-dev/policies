{
    id: "SCORECARD-BINARY-ARTIFACTS"
    meta: {
        name: "No Binary Artifacts"
        description: "Reads the project's attested [OpenSSF Scorecard](https://scorecard.dev) results. Fails when Scorecard detected executables checked into the repository."
    }
    tenets: [
        {
            id: "01-scorecard"
            code: "size(outputs.bin_artifacts_checks) > 0 && outputs.bin_artifacts_checks.all(c, c.score == 10)"
            outputs: {
                bin_artifacts_checks: {
                    code: "has(predicates[0].data.checks) ? predicates[0].data.checks.filter(c, c.name == 'Binary-Artifacts' && has(c.score)) : [] "
                }
            }
            predicates: {
                types: [
                    "https://scorecard.dev/result/v0.1"
                ]
            }
            assessment: {
                message: "Scorecard did not detect any binaries in the repo"
            }
            error: {
                message: "Scorecard detected binaries in the repository"
                guidance: "Check your codebase and remove any checked-in executables"
            }
        }
    ]
}
