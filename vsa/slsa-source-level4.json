{
  "id":  "slsa-source-level-4",
  "meta":  {
    "description":  "Checks that a SLSA Verification Summary Attestation records a passed verification at SLSA Source Level 4.",
    "assertMode":  "AND",
    "enforce":  "ON",
    "origin":  {
      "name":  "slsa-source-level4.hjson",
      "digest":  {
        "sha256":  "dbd1e22ad987b1c93b47e330f0b92c121fe90973ecbca38e15d745a61b3b60f7",
        "sha512":  "ad4bd6dab371daf1532bb0a852cb93d4940cf43810f962f3cd726d2639a7effce574f49a2c84c21c6d22ebe595f7a278133eff0ff8bf42545f115eefd8b1938c"
      }
    },
    "name":  "SLSA Source Level 4 Verified"
  },
  "tenets":  [
    {
      "id":  "01",
      "code":  "outputs.pass && outputs.levels.exists(k, v, v == 'SLSA_SOURCE_LEVEL_4')",
      "predicates":  {
        "types":  [
          "https://slsa.dev/verification_summary/v1"
        ]
      },
      "outputs":  {
        "levels":  {
          "code":  "has(predicates[0].data.verifiedLevels) ? predicates[0].data.verifiedLevels : [] "
        },
        "pass":  {
          "code":  "has(predicates[0].data.verificationResult) ? predicates[0].data.verificationResult == 'PASSED' : false"
        }
      },
      "error":  {
        "message":  "SLSA Source L4 not recorded in verification summary"
      },
      "assessment":  {
        "message":  "VSA attesting SLSA_SOURCE L4 compliance checks"
      }
    }
  ]
}
