{
  "id":  "slsa-build-deps-level-2",
  "meta":  {
    "description":  "Reads a SLSA Verification Summary Attestation and fails when any of the verified dependencies does not reach SLSA Build Level 2 or higher.",
    "assertMode":  "AND",
    "controls":  [
      {
        "id":  "LEVEL_2",
        "framework":  "SLSA",
        "class":  "BUILD"
      }
    ],
    "enforce":  "ON",
    "origin":  {
      "name":  "slsa-build-deps-level-2.hjson",
      "digest":  {
        "sha256":  "04d0d685f97f0c266320a8c2ecec780eacdd7b1ae7d12f6a2c831256706732a4",
        "sha512":  "80e7f38a95f3063eb08f8c9ffe6790ae8e24650fd11d3d72ac2ef3101d6d511d738824987404bdb6e23100eb8355f2030371b400e22d8ed8b65d7b20e235b56f"
      }
    },
    "name":  "Dependencies at SLSA Build Level 2"
  },
  "tenets":  [
    {
      "code":  "outputs.levels.filter(level, (outputs.levels[level] != '0' && level == 'SLSA_BUILD_LEVEL_1' )).size() == 0",
      "predicates":  {
        "types":  [
          "https://slsa.dev/verification_summary/v1"
        ]
      },
      "outputs":  {
        "levels":  {
          "code":  "has(predicates[0].data.dependencyLevels) ? predicates[0].data.dependencyLevels : {} "
        }
      },
      "error":  {
        "message":  "Some verified dependencies don't meet SLSA_BUILD_LEVEL_2"
      },
      "assessment":  {
        "message":  "All verified dependencies are SLSA_BUILD_LEVEL_2+"
      }
    }
  ]
}
