{
  "id":  "SNAPPY-REPO-HAS-ISSUES",
  "meta":  {
    "description":  "Reads the attested repository data and fails when the issues feature is not enabled.",
    "assertMode":  "AND",
    "enforce":  "ON",
    "origin":  {
      "name":  "repo-issues.hjson",
      "digest":  {
        "sha256":  "adba8570653beb412bde0b1edf37d9c8070380932e18b61021c77065aaa4c3c3",
        "sha512":  "994b26ed1499fbdb1bc2689318818e137c982a51594c4d6532cc02690746e9fbb55f6865c342e4adcd59dde2abe399816c52ea526de9a18df7ac4d8e44c802f6"
      }
    },
    "name":  "Issues Enabled"
  },
  "tenets":  [
    {
      "code":  "size(predicates) > 0",
      "predicates":  {
        "types":  [
          "http://github.com/carabiner-dev/snappy/specs/github/repo.yaml",
          "http://github.com/carabiner-dev/snappy/specs/repo.yaml"
        ]
      },
      "assessment":  {
        "message":  "Found attested repository data"
      }
    },
    {
      "id":  "01",
      "code":  "outputs[\"issues\"]",
      "predicates":  {
        "types":  [
          "http://github.com/carabiner-dev/snappy/specs/github/repo.yaml",
          "http://github.com/carabiner-dev/snappy/specs/repo.yaml"
        ]
      },
      "outputs":  {
        "issues":  {
          "code":  "has(predicates[0].data.values.has_issues) ? predicates[0].data.values.has_issues : false"
        }
      },
      "error":  {
        "message":  "Issues are not enabled in the repo",
        "guidance":  "Turn on the issues setting in the repository"
      },
      "assessment":  {
        "message":  "Issues feature is enabled in the repository"
      }
    }
  ]
}
