              "uri": "git+https://github.com/carabiner-dev/policies@3c00b05a78e32dd79385dcbfbdfa91b405e386c4#protobom/protobom-sbom-hash-algorithms.hjson",
              "digest": {
                "sha256": "096467b7901a3e227813e7786eff292bdfff62641f9b4380ef467bbeb25efcd1",
                "sha512": "b9e41cde171f564f4bb18c5477a3c551f594ccd0bf74fc1dc241b868ccdd23b79aca32787919e79308062b344ae289fe9b2c5ac528d77a3dc4cbf10e137fda0f"
              },
              "downloadLocation": "git+https://github.com/carabiner-dev/policies@3c00b05a78e32dd79385dcbfbdfa91b405e386c4#protobom/protobom-sbom-hash-algorithms.hjson"
            }
          },
          "predicates": {
            "types": [
              "https://spdx.dev/Document",
              "https://cyclonedx.org/bom"
            ]
          },
          "tenets": [
            {
              "id": "hash-algorithms",
              "code": "size(outputs.hashes) > 0 && outputs.hashes.all(h, size(h) > 0 && h.all(alg, alg != 'UNKNOWN'))",
              "outputs": {
                "hashes": {
                  "code": "size(sboms) > 0 ? sboms[0].get_node_list().get_root_nodes().map(n, n.hashes) : []"
                }
              },
              "error": {
                "message": "One or more top level components have no hash keyed by a recognized cryptographic algorithm",
                "guidance": "Identify the hash algorithm of each component checksum using standard algorithm names (for example SHA256)"
              },
