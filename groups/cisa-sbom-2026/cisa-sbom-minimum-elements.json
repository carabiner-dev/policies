    {
      "id": "component-producer",
      "meta": {
        "description": "Top level components identify the entity that created them",
        "controls": [
          {
            "id": "PRODUCER",
            "framework": "CISA-SBOM-2026",
            "class": "COMPONENT-DATA"
          }
        ]
      },
      "policies": [
        {
          "id": "PROTOBOM-SBOM-PRODUCERS",
          "meta": {
            "description": "# Component Producer\n\nChecks that the top level components of the SBOM identify the\nentity that created them. This implements the _Component Producer_\nelement of the CISA 2026 SBOM Minimum Elements, which replaces the\n2021 _Supplier Name_ element.\n\nThe check looks at each root component's originators and falls\nback to its suppliers, as most SBOM generators record the\nproducing entity in the supplier field.\n\nNote: protobom does not yet populate supplier data when reading\nCycloneDX documents, so CycloneDX SBOMs currently fail this check\neven when the component supplier is set.",
            "assertMode": "AND",
            "controls": [
              {
                "id": "PRODUCER",
                "framework": "CISA-SBOM-2026",
                "class": "COMPONENT-DATA"
              }
            ],
            "enforce": "ON",
            "origin": {
              "name": "PROTOBOM-SBOM-PRODUCERS",
              "uri": "git+https://github.com/carabiner-dev/policies@3c00b05a78e32dd79385dcbfbdfa91b405e386c4#protobom/protobom-sbom-producers.hjson",
              "digest": {
                "sha256": "dc023e7df1f74a60e756ef47c133f78575e9e732fffc8e107973ae8366561bb5",
                "sha512": "f45e78497bbf4a91f41b49dd2d7a715f5d9d0545d7186bd57b54570be5768dfaf485588ac7b0c8f0f533503394f605ce11fad6cef0c250adcf739c55fd1fe380"
              },
              "downloadLocation": "git+https://github.com/carabiner-dev/policies@3c00b05a78e32dd79385dcbfbdfa91b405e386c4#protobom/protobom-sbom-producers.hjson"
            }
          },
          "predicates": {
            "types": [
              "https://spdx.dev/Document",
              "https://cyclonedx.org/bom"
            ]
          },
          "tenets": [
            {
              "id": "producers",
              "code": "size(outputs.producers) > 0 && outputs.producers.all(p, size(p) > 0 && p.all(e, e.name != ''))",
              "outputs": {
                "producers": {
                  "code": "size(sboms) > 0 ? sboms[0].get_node_list().get_root_nodes().map(n, size(n.originators) > 0 ? n.originators : n.suppliers) : []"
                }
              },
              "error": {
                "message": "One or more top level components do not identify the entity that produced them",
                "guidance": "Set the originator (SPDX) or supplier of each top level component, or explicitly mark it as of unknown provenance"
              },
              "assessment": {
                "message": "All top level components identify their producer"
              }
            }
          ]
        }
      ]
    },
