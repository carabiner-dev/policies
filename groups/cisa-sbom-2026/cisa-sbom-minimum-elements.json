      "policies": [
        {
          "id": "PROTOBOM-SBOM-LICENSES",
          "meta": {
            "description": "# Component License\n\nChecks that the top level components of the SBOM carry license\ninformation. This implements the _Component License_ element of\nthe CISA 2026 SBOM Minimum Elements.\n\nThe check accepts declared license lists or a concluded license on\neach root component. Explicit unknown markers (such as SPDX\nNOASSERTION) satisfy the element, as CISA requires unknown license\ninformation to be explicitly indicated rather than omitted.\n\nThis policy only checks for the presence of license data. To\nenforce that licenses are OSI/FSF approved, pair it with\nsbom-licenses-are-foss.",
            "assertMode": "AND",
            "controls": [
              {
                "id": "LICENSE",
                "framework": "CISA-SBOM-2026",
                "class": "COMPONENT-DATA"
              }
            ],
            "enforce": "ON",
            "origin": {
              "name": "PROTOBOM-SBOM-LICENSES",
              "uri": "git+https://github.com/carabiner-dev/policies@3c00b05a78e32dd79385dcbfbdfa91b405e386c4#protobom/protobom-sbom-licenses.hjson",
