              "https://cyclonedx.org/bom"
            ]
          },
          "tenets": [
            {
              "id": "licenses",
              "code": "size(outputs.licenses) > 0 && outputs.licenses.all(l, size(l) > 0 && l.all(x, x != ''))",
              "outputs": {
                "licenses": {
                  "code": "size(sboms) > 0 ? sboms[0].get_node_list().get_root_nodes().map(n, size(n.licenses) > 0 ? n.licenses : [n.license_concluded]) : []"
                }
