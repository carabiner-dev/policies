{
  "id":  "OSPS-BR-06",
  "meta":  {
    "description":  "All releases MUST be signed or accounted for in a signed manifest including each asset's cryptographic hashes.\n\nChecked with the `slsa/has-attestation` policy, which requires signed SLSA provenance for the release.",
    "controls":  [
      {
        "id":  "06",
        "framework":  "OSPS",
        "class":  "BR"
      }
    ],
    "enforce":  "ON",
    "origin":  {
      "name":  "osps-br-06.hjson",
      "digest":  {
        "sha256":  "5e025adcfbec870fd14a5106a673094959601292a3ef2b8a0dfc130107f4db4b",
        "sha512":  "8136d7afc4f3a730091f161689359dc3e805e65792bbb2a539c2b25e2476e065027ddeb420912c8e4c5b0d3e52a2827e63840dd931cfc9505e48b48ef077e8bb"
      }
    },
    "name":  "Signed Releases"
  },
  "blocks":  [
    {
      "policies":  [
        {
          "id":  "slsa-has-attestation",
          "meta":  {
            "description":  "Checks if a SLSA provenance attestation is available",
            "assertMode":  "AND",
            "enforce":  "ON",
            "origin":  {
              "name":  "slsa-has-attestation",
              "uri":  "git+https://github.com/carabiner-dev/policies@99012828fd251a3ed12a561479f677bedd3e9bf9#slsa/has-attestation.json",
              "digest":  {
                "sha256":  "b7f9731dbed37e8eb838afbe57fbba20d26270dc656b4d218541e11e00ba8193",
                "sha512":  "dbf56a2c60da7529a4d05e63304b48ed42863ef71e824d332fcf654dfd8915cf0612521c984bd0aba96aece51f69ccf616590313668368951fc1082942b2c278"
              },
              "downloadLocation":  "git+https://github.com/carabiner-dev/policies@99012828fd251a3ed12a561479f677bedd3e9bf9#slsa/has-attestation.json"
            }
          },
          "tenets":  [
            {
              "id":  "slsa",
              "code":  "size(predicates) > 0",
              "predicates":  {
                "types":  [
                  "https://slsa.dev/provenance/v0.2",
                  "https://slsa.dev/provenance/v1"
                ]
              },
              "error":  {
                "message":  "No SLSA attestation found",
                "guidance":  "Capture the build process in a SLSA provenance attestation"
              },
              "assessment":  {
                "message":  "SLSA provenance attestation found"
              }
            }
          ]
        }
      ]
    }
  ]
}
