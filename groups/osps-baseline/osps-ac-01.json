{
  "id":  "OSPS-AC-01",
  "meta":  {
    "description":  "The project's version control system MUST require multi-factor authentication for collaborators modifying the project repository settings or accessing sensitive data.\n\nChecked through the repository's SLSA source provenance with the `slsa-source/ghorg` policy, which establishes that the repository is hosted in a GitHub organization.",
    "controls":  [
      {
        "id":  "01",
        "framework":  "OSPS",
        "class":  "AC"
      }
    ],
    "enforce":  "ON",
    "origin":  {
      "name":  "osps-ac-01.hjson",
      "digest":  {
        "sha256":  "bb3692b9bb8deb738a3836e3ff39378ac9ef19e60ef568b5bc3a55dd1769d411",
        "sha512":  "9a54a737e86515351b14f5a3b76cc785a9f202afdebb0784549e6e49244b478f00b548f886f1635a04852412c85e98b01b1d077f605f8366ea74f93884d9efb7"
      }
    },
    "name":  "Use MFA for Sensitive Actions"
  },
  "blocks":  [
    {
      "policies":  [
        {
          "id":  "SLSA-SRC-GHORG",
          "meta":  {
            "description":  "Evaluates if athe repository is hosted in GitHub",
            "assertMode":  "AND",
            "enforce":  "ON",
            "origin":  {
              "name":  "SLSA-SRC-GHORG",
              "uri":  "git+https://github.com/carabiner-dev/policies@99012828fd251a3ed12a561479f677bedd3e9bf9#slsa-source/ghorg.json",
              "digest":  {
                "sha256":  "da566b451637ae149ac648cfc80f59e0129bdfcbbc02403c440b62281e0bafd3",
                "sha512":  "fc09e14f2693ac3c543e12cb262904455598828377c59df366273593d5335b09ed4a28c4ae87eab876aa8bbd692380d6b43038ca8837415eccf9863bcc35be0d"
              },
              "downloadLocation":  "git+https://github.com/carabiner-dev/policies@99012828fd251a3ed12a561479f677bedd3e9bf9#slsa-source/ghorg.json"
            }
          },
          "tenets":  [
            {
              "id":  "01",
              "code":  "outputs.org.name.indexOf('github.com') == 0 ",
              "predicates":  {
                "types":  [
                  "https://github.com/slsa-framework/slsa-source-poc/source-provenance/v1-draft"
                ]
              },
              "outputs":  {
                "org":  {
                  "code":  "github.orgDescriptorFromURI(predicate.data.repoUri)"
                }
              },
              "assessment":  {
                "message":  "GitHub organization found in SLSA provenance"
              }
            }
          ]
        }
      ]
    }
  ]
}
