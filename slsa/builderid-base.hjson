{
    id: "SLSA-BUILDER-BASE"
    meta: {
        // No name on this policy, on purpose. slsa-framework/source-actions
        // (the legacy source provenance workflow) reads this file unpinned
        // from main through an action that installs ampel v1.3.6, and
        // ampel before v1.3.7 cannot parse `meta.name`: every run of that
        // workflow fails with "unable to parse a policy, group or policySet".
        // Restore the name once no consumer is left on an engine that old.
        // name: "Expected Builder (Deprecated)"
        description:
            '''
            Deprecated, use `slsa/slsa-builder-id.json` instead.

            Checks that the builder recorded in the artifact's SLSA provenance matches the `builderId` context value, either exactly or as a prefix followed by `@`.
            '''
    }
    context: {
        builderId: {
            required: true
            type: "string"
        }
    }
    tenets: [
        {
            predicates: {
                types: [
                    "https://slsa.dev/provenance/v1"
                ]
            }
            outputs: {
                builderId: {
                    code: "has(predicates[0].data.runDetails) ? (has(predicates[0].data.runDetails.builder) ? predicates[0].data.runDetails.builder.id : '' ) : '' "
                }
            }
            code: "outputs.builderId == context.builderId || outputs.builderId.startsWith(context.builderId + '@')"
            assessment: {
                message: "Authorized builder ID detected"
            }
            error: {
                message: "Builder identifier mismatch"
                guidance: "The attestation builder does not match the context defined builder (want {{ .Context.builderId }} got {{ .Outputs.builderId }})"
            }
        }
    ]
}
