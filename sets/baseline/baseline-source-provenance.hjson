{
    id: "OSPS"
    meta: {
        name: "OpenSSF Security Baseline (Source Provenance)"
        description: "Evaluates a project against the [Open Source Project Security Baseline](https://baseline.openssf.org) starting from the repository's SLSA source provenance, chaining from it to the attestations each control reads."
        frameworks: [
            {
                id: "OSPS"
                name: "OSPS Security Baseline"
            }
        ]
    }
    commons: {
        references: [
            {
                location: {
                    uri: "git+https://github.com/carabiner-dev/policies#sets/baseline/osps-baseline.policy.json"
                    digest: {
                        sha256: "ba069d6f37afff1aafa0b483949f7d05a4137cba50406875055d222fa138e99c"
                    }
                }
            }
        ]
    }
    policies: [
        {
            id: "OSPS-AC-01"
            chain: [
                {
                    predicate: {
                        type: "https://github.com/slsa-framework/source-tool/source-provenance/v1"
                        selector: "github.orgDescriptorFromURI(predicate.data.repo_uri)"
                    }
                }
            ]
        }
        {
            id: "OSPS-AC-02"
            chain: [
                {
                    predicate: {
                        type: "https://github.com/slsa-framework/source-tool/source-provenance/v1"
                        selector: "github.orgDescriptorFromURI(predicate.data.repo_uri)"
                    }
                }
            ]
        }
        {
            source: {
                location: {
                    uri: "git+https://github.com/carabiner-dev/policies#slsa-source/continuity.json "
                    digest: {
                        sha256: "ba069d6f37afff1aafa0b483949f7d05a4137cba50406875055d222fa138e99c"
                    }
                }
            }
            meta: {
                controls: [
                    {
                        framework: "OSPS"
                        class: "AC"
                        id: "03"
                    }
                ]
            }
        }
        {
            id: "OSPS-AC-04"
        }
        {
            id: "OSPS-GV-01"
        }
    ]
}
