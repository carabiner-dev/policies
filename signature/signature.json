{
  "id": "detached-signature",
  "meta": {
    "description": "Checks that the artifact carries a verified detached signature or sigstore bundle from an accepted signer. The signer identity is matched by AMPEL against the identities given at verification time or declared in the policy.",
    "assertMode": "AND",
    "enforce": "ON",
    "origin": {
      "name": "signature.hjson",
      "digest": {
        "sha256": "7812aff14c8264811d556d2ba5b736c0a6e7ed7d637d257c47729b3422b5d5f8",
        "sha512": "7fd93bd30ba90d22d6a05716002a2495dd335628ae06f4f76d96cbd52208398f848d3bf140bf17bb3d0ed27bd9b56fb2b94865f956bcf0fd89fb5eb469f1659d"
      }
    }
  },
  "tenets": [
    {
      "id": "signature-check",
      "code": "size(predicates) > 0",
      "predicates": {
        "types": [
          "https://carabiner.dev/ampel/signature/v1"
        ]
      },
      "error": {
        "message": "No detached signature found",
        "guidance": "No signature found or unkown key"
      },
      "assessment": {
        "message": "Signature verfiied"
      }
    }
  ]
}
