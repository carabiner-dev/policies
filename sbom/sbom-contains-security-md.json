{
  "id":  "sbom-contains-security-md",
  "meta":  {
    "description":  "Looks through the files listed in the project's SBOM for a `SECURITY.md` file and fails when none is found.",
    "assertMode":  "AND",
    "enforce":  "ON",
    "origin":  {
      "name":  "sbom-contains-security-md.hjson",
      "digest":  {
        "sha256":  "941330a8f42c19a5dda66517f49173ac451a2fe04e2679ecc1f15682896af3aa",
        "sha512":  "6eb429fb7d3a3657e6b37f7de3103d458bde35a7e476feb204ada095c97a4b4f4fe641d751b063dee48891dae1f27eb439369a311b3e80900b90fe6bb4f07061"
      }
    },
    "name":  "Security Policy in SBOM"
  },
  "tenets":  [
    {
      "id":  "01-sbom",
      "code":  "size(outputs[\"files\"]) > 0",
      "predicates":  {
        "types":  [
          "https://spdx.dev/Document",
          "https://cyclonedx.org/bom"
        ]
      },
      "outputs":  {
        "files":  {
          "code":  "sboms[0].get_node_list().get_nodes().filter(n, (n.name == 'SECURITY.md' ))"
        }
      },
      "error":  {
        "message":  "Could not detect a SECURITY.md file in the SBOM.",
        "guidance":  "Add a file named SECURITY.md to your project's vulnerability disclosure policy"
      },
      "assessment":  {
        "message":  "Found a SECURITY.md file in the project's SBOM."
      }
    }
  ]
}
