{
  "id": "sbom-contains-changelog",
  "meta": {
    "description": "Looks through the files listed in the project's SBOM for a changelog (`CHANGELOG`, `CHANGELOG.md`, `CHANGELOG.rst` or `CHANGELOG.txt`) and fails when none is found.",
    "assertMode": "AND",
    "enforce": "ON",
    "origin": {
      "name": "sbom-contains-changelog.hjson",
      "digest": {
        "sha256": "2457a5ca092c70d07640b927c95d0387e909149c71e487860e23b66beb44dcfd",
        "sha512": "7182e89677c816b34cb7bde144be720f8ff43fc054cf9134039bf6692299a51e1b2c9df12a6c28e3f2c80a35b37e3dbac7702a470171ec250c2b6304f8b9d1e8"
      }
    },
    "name": "Changelog in SBOM"
  },
  "tenets": [
    {
      "id": "01-sbom",
      "code": "size(outputs[\"files\"]) > 0",
      "predicates": {
        "types": [
          "https://spdx.dev/Document",
          "https://spdx.dev/Document/v3",
          "https://cyclonedx.org/bom"
        ]
      },
      "outputs": {
        "files": {
          "code": "sboms[0].get_node_list().get_nodes().filter(n, (n.name == 'CHANGELOG' || n.name == 'changelog.txt' || n.name == 'CHANGELOG.md' || n.name == 'CHANGELOG.rst' || n.name == 'CHANGELOG.txt'))"
        }
      },
      "error": {
        "message": "Could not detect a changelog file in the SBOM.",
        "guidance": "Add a file named CHANGELOG to your project's codebase registering major changes."
      },
      "assessment": {
        "message": "Found a changelog in the project's SBOM."
      }
    }
  ]
}
