{
  "id": "PROTOBOM-NAME",
  "meta": {
    "description": "Checks that every top-level component of the SBOM has a name. The SBOM is read through protobom, so SPDX and CycloneDX documents are handled alike.",
    "assertMode": "AND",
    "enforce": "ON",
    "origin": {
      "name": "protobom-sbom-names.hjson",
      "digest": {
        "sha256": "c89e331aa0d1b7502eb300532db71b8aa645c0da4a724c4612696eb8126e2fa4",
        "sha512": "819ef6d8163a252b83ebd2accca9f3566b9126fd6085880eabf949c6aa15e81a06214cf241716bdba817356eb80555946e135da2eeb04c9ca53908f5b34e7d22"
      }
    },
    "name": "Component Names"
  },
  "predicates": {
    "types": [
      "https://spdx.dev/Document",
      "https://spdx.dev/Document/v3",
      "https://cyclonedx.org/bom"
    ]
  },
  "tenets": [
    {
      "code": "outputs.names.all(s, s != \"\")",
      "outputs": {
        "names": {
          "code": "sboms[0].get_node_list().get_root_nodes().map(s, s.name)"
        }
      },
      "assessment": {
        "message": "Top level components have their name set"
      }
    }
  ]
}
