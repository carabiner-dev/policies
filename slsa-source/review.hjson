{
    id: "SLSA-SRC-REVIEW"
    meta: {
        name: "Code Review Required"
        description: "Checks the repository's SLSA source provenance for the property recording that changes require code review."
    }
    tenets: [
        {
            id: "01"
            predicates: {
                types: [
                    "https://github.com/slsa-framework/source-tool/source-provenance/v1"
                    "https://github.com/slsa-framework/slsa-source-poc/source-provenance/v1-draft"
                ]
            }
            outputs: {
                controls: {
                    code: "predicates[0].data.controls.map(c, c.name)"
                }
            }
            code: "outputs.controls.one(c, c == 'REVIEW_ENFORCED')"
            assessment: {
                message: "Repository enforces code review"
            }
        }
    ]
}
